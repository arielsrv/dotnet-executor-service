<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 is what .NET Framework 4.6.2+ and Mono consumers restore; the modern targets get
         their own build so they keep the in-box APIs and the zero-dependency package. -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>ExecutorService</RootNamespace>
    <AssemblyName>ExecutorService</AssemblyName>
    <!-- Native AOT does not apply to netstandard2.0, and the analyzer refuses to run there. -->
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ExecutorService</PackageId>
    <Title>ExecutorService</Title>
    <Description>A .NET port of Java's java.util.concurrent.ExecutorService: fixed-size pools of dedicated threads with explicit lifecycle (Shutdown, ShutdownNow, AwaitTermination) and Task-based futures.</Description>
    <PackageTags>executor;executorservice;threadpool;concurrency;threading;java;tasks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Replaced at pack time with this version's own CHANGELOG section; see below. The link is the
         fallback for versions the changelog does not describe, such as local preview builds. -->
    <PackageReleaseNotes>See https://github.com/arielsrv/dotnet-executor-service/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <ChangelogFile>$(MSBuildThisFileDirectory)../../CHANGELOG.md</ChangelogFile>

    <!-- Compares the package being built against the last one on nuget.org and fails the pack on a
         breaking change: a dropped target framework, a removed type, a signature that no longer
         matches. The PublicApiAnalyzers below track the same surface in source; this checks what
         actually ships, which is what consumers bind against. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.7.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/"/>
    <None Include="../../icon.png" Pack="true" PackagePath="/"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all"/>
  </ItemGroup>

  <!-- The only dependencies in the package, and only on the target that cannot avoid them: netstandard2.0
       has neither the Metrics API nor IAsyncDisposable in the framework. net8.0 and net10.0 stay at zero. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces"/>
    <PackageReference Include="System.Diagnostics.DiagnosticSource"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExecutorService.Tests"/>
  </ItemGroup>

  <!-- The floor of a shipped dependency is a promise to consumers: NuGet resolves upwards, so raising it
       forces every .NET Framework consumer to follow, while lowering it can break the build. Dependabot is
       told not to propose those bumps, but a person or a tool still can, and the change looks like ordinary
       maintenance in a diff. It is not, so it fails the build until someone says so on purpose here. -->
  <Target Name="VerifyShippedDependencyFloor" BeforeTargets="Build" Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <ItemGroup>
      <_UnexpectedFloor Include="@(PackageVersion)"
                        Condition="'%(Identity)' == 'Microsoft.Bcl.AsyncInterfaces' and '%(Version)' != '8.0.0'"/>
      <_UnexpectedFloor Include="@(PackageVersion)"
                        Condition="'%(Identity)' == 'System.Diagnostics.DiagnosticSource' and '%(Version)' != '8.0.1'"/>
    </ItemGroup>
    <Error Condition="'@(_UnexpectedFloor)' != ''"
           Code="EXEC0001"
           Text="Shipped dependency floor changed: @(_UnexpectedFloor->'%(Identity) is pinned at %(Version)', ', '). Consumers inherit this floor, so treat it as a public change: note it in CHANGELOG.md and update the expected version in VerifyShippedDependencyFloor to match."/>
  </Target>

  <!-- nuget.org shows PackageReleaseNotes on the package page. A link there makes the reader go find
       what changed; the notes themselves say it. CHANGELOG.md stays the single source of truth and the
       section matching the version being packed is lifted out of it here. -->
  <UsingTask TaskName="ReadChangelogSection"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ChangelogFile ParameterType="System.String" Required="true"/>
      <ReleaseVersion ParameterType="System.String" Required="true"/>
      <Notes ParameterType="System.String" Output="true"/>
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          string text = System.IO.File.ReadAllText(ChangelogFile);
          string pattern = @"^## \[" + System.Text.RegularExpressions.Regex.Escape(ReleaseVersion)
                           + @"\][^\n]*\n(.*?)(?=^## \[)";
          var match = System.Text.RegularExpressions.Regex.Match(
              text,
              pattern,
              System.Text.RegularExpressions.RegexOptions.Singleline
                  | System.Text.RegularExpressions.RegexOptions.Multiline);
          Notes = match.Success ? match.Groups[1].Value.Trim() : string.Empty;
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="SetPackageReleaseNotesFromChangelog" BeforeTargets="GenerateNuspec" Condition="Exists('$(ChangelogFile)')">
    <ReadChangelogSection ChangelogFile="$(ChangelogFile)" ReleaseVersion="$(PackageVersion)">
      <Output TaskParameter="Notes" PropertyName="_ChangelogNotes"/>
    </ReadChangelogSection>
    <!-- A preview build between releases has no section of its own; it keeps the link instead. -->
    <PropertyGroup Condition="'$(_ChangelogNotes)' != ''">
      <PackageReleaseNotes>$(_ChangelogNotes)</PackageReleaseNotes>
    </PropertyGroup>
    <Message Importance="high" Condition="'$(_ChangelogNotes)' == ''"
             Text="No CHANGELOG.md section for $(PackageVersion); packing with the changelog link as release notes."/>
  </Target>

</Project>
