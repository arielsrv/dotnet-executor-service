<Project>

  <!-- Central Package Management: every PackageReference version lives here. -->
  <ItemGroup>
    <!-- Shipped: referenced only by the netstandard2.0 build of the library. Kept at the lowest version
         that works, because a library's dependency floor is what its consumers inherit. -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />

    <!-- Build / packaging -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />

    <!-- Samples -->
    <!-- The quick start sample consumes the library as a consumer does, from nuget.org. Bump this to the
         version just released to smoke-test that release; it is never the version being built here. -->
    <PackageVersion Include="ExecutorService" Version="0.7.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />

    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />

    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
  </ItemGroup>

</Project>
